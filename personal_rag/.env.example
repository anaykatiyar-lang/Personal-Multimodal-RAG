# ==============================================================================
# PERSONAL ADVANCED RAG PLATFORM — ENVIRONMENT CONFIGURATION
# Default configuration: 100% CPU, local-first, zero GPU credit expenditure.
# ==============================================================================

# ── Hardware & Execution Policy ──────────────────────────────────────────────
# Strict cost-control flags. Keep False unless explicitly authorized.
CPU_ONLY=true
GPU_EXECUTION_APPROVED=false
CLOUD_INSTANCE_AUTOSTART=false
MODEL_DOWNLOAD_AUTOSTART=false

# Target device when GPU is approved: "cpu", "cuda", "rocm", "mps"
DEVICE=cpu

# ── Storage Configuration ────────────────────────────────────────────────────
# Local SQLite metadata and full-text search database
SQLITE_DB_PATH=./data/knowledge_base.db

# Qdrant vector database path (local embedded mode)
QDRANT_STORAGE_PATH=./data/qdrant
QDRANT_COLLECTION_NAME=personal_knowledge_base

# Raw document storage root
DOCUMENTS_DIR=./data/documents

# Ingestion fingerprint cache
CACHE_DIR=./cache

# ── Embedding Model Configuration ────────────────────────────────────────────
# Default: Lightweight local embedding model
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# ── Retrieval & Reranking Settings ───────────────────────────────────────────
# Hybrid search weights (Reciprocal Rank Fusion)
RRF_K=60
DENSE_SEARCH_WEIGHT=0.65
LEXICAL_SEARCH_WEIGHT=0.35

# Chunking thresholds
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=100
PARENT_CHUNK_SIZE=1500

# Reranker (disabled by default to conserve CPU cycles & RAM)
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-small

# ── Generation & LLM Provider ────────────────────────────────────────────────
# Provider options: "mock", "local_transformers", "openai_compatible"
LLM_PROVIDER=mock
LLM_MODEL_NAME=mock-model
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# OpenAI-compatible local server (e.g. Ollama, vLLM, LM Studio)
LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=not-needed

# Optional external provider (DISABLED by default for privacy)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Server & UI Configuration ────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
UI_HOST=127.0.0.1
UI_PORT=8501
LOG_LEVEL=INFO

